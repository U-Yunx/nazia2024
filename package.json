{
  "name": "ana24",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "postinstall": "node scripts/ensure-test-browser.mjs",
    "deploy": "node scripts/check-deploy-env.mjs && vite build",
    "deploy:cloudflare": "node scripts/check-cloudflare-env.mjs && npm run deploy && wrangler deploy",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "apk:check:env": "node scripts/check-android-env.mjs",
    "apk:ensure:android": "node scripts/ensure-android-platform.mjs",
    "apk:signing": "node scripts/android-signing.mjs",
    "apk:debug": "npm run apk:ensure:android && node scripts/check-apk-supabase-env.mjs && npm run build && node scripts/check-apk-supabase-env.mjs --verify && cap sync android && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run apk:check:env && npm run apk:ensure:android && node scripts/check-apk-supabase-env.mjs && npm run build && node scripts/check-apk-supabase-env.mjs --verify && cap sync android && npm run apk:signing && cd android && ./gradlew assembleRelease",
    "apk:publish": "npm run apk:release && node scripts/publish-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.18",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.21",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "globals": "^16.5.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.11",
    "wrangler": "4.86.0"
  }
}