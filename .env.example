# ANA24 — environment variable template
#
# Copy to `.env.local` for local development (it is gitignored):
#   cp .env.example .env.local
#
# ── PUBLIC values (safe to ship in the browser bundle) ──────────────────────
# The Supabase URL + anon (publishable) key. Linked Supabase projects on the
# hosted platform inject these automatically; locally, fill them in here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── DEPLOY-ONLY secrets (never put real values in this repo) ────────────────
# Required by `npm run deploy:pages` (Cloudflare Pages upload via wrangler).
# These are NOT VITE_-prefixed and are NEVER baked into the client bundle.
#
# Provide them to the deploy step as environment/CI secrets (e.g. GitHub
# Actions secrets, Cloudflare Pages build env, or your platform's secret store)
# — do NOT commit them, and do NOT paste them into .env.local for anything
# that could be served to visitors.
#
# 1. CLOUDFLARE_API_TOKEN — token with "Cloudflare Pages — Edit" permission.
#    Create: https://developers.cloudflare.com/fundamentals/api/get-started/create-token/
# 2. CLOUDFLARE_ACCOUNT_ID — your Cloudflare account ID (dashboard right
#    sidebar). Public, but required for Pages deploys.
#
# Leave these commented out here — they are documented, not stored.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── Cloudflare Pages Git-integrated builds ──────────────────────────────────
# Cloudflare Pages does NOT read .nvmrc. If you build via the Pages dashboard
# (Git integration) instead of wrangler direct upload, set the build
# environment variable NODE_VERSION=20.19.0 there — Vite 7 requires
# Node 20.19+ / 22.12+.
# NODE_VERSION=20.19.0
