# ANA24 — local environment template
# --------------------------------------
# Copy this file to `.env.local` and fill in the values for local runs:
#   cp .env.example .env.local
#
# These two variables are REQUIRED for the app to connect to Supabase
# (sign-in, live market data, paper trading, payouts). Without them the app
# shows the "Supabase connection required" screen.
#
# They are PUBLIC / publishable values — safe to ship to the browser.
# Never put real secrets (API keys for AI providers, broker tokens, etc.)
# here; those belong in Supabase Edge Function secrets.
#
# The platform injects these automatically for the managed Preview and
# Production environments, so you only need this file when running the app
# yourself (e.g. `npm run dev` on your own machine or a fresh sandbox).

# Your Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xopygzpepikerwqxzqzu.supabase.co

# Your Supabase public key — either the legacy anon JWT or the newer
# publishable key (Settings → API → Project API keys).
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# --- Deployment ---
# The app deploys as a static SPA with `npm run build`; the platform hosting it
# supplies the VITE_* variables above. No third-party CI/CD (e.g. a Cloudflare
# Pages pipeline) ships in this repo anymore — deployment is handled by the
# platform itself. Real secrets (broker keys, MetaApi tokens) never belong
# here; they are stored as Supabase Edge Function secrets or in encrypted
# database columns, server-side only.