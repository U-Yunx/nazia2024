# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment files — never commit real env values.
# (.env.example is the committed template and is NOT ignored.)
.env
.env.*
!.env.example

# Wrangler / Cloudflare caches and credentials (wrangler.toml IS committed —
# it contains no secrets)
.wrangler

# Playwright CLI runtime artifacts (snapshots/screenshots/videos)
.playwright-cli

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?